# ==========================================
# Mastery Engine / Monorepo .gitignore
# ==========================================

# --- Environment & Secret Files ---
.env
.env.*
!.env.example
*.pem
*.key
*.cert
*.crt
credentials.json

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDE & Editor Settings ---
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace

# --- Node / Frontend (web/) ---
node_modules/
*/node_modules/
.pnp
.pnp.js
.yarn/cache
.yarn/unplugged
.yarn/build-state.yml
.yarn/install-state.gz

# Next.js Build Output
.next/
*/.next/
out/
*/out/
build/
dist/
.vercel
*.tsbuildinfo
next-env.d.ts

# Frontend Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python / Backend (agents/) ---
__pycache__/
*/__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual Environments
.venv/
*/.venv/
venv/
*/venv/
ENV/
env/

# Python Tools & Caches
.cache/
*/.cache/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
*.egg-info/
.eggs/

# Backend Logs & Run state
*.log
*.sqlite3
*.db

# --- Supabase CLI ---
.supabase/
supabase/.temp/

# --- Temp & Scratch Files ---
tmp/
temp/
*.tmp
*.bak
